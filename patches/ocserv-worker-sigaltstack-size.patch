+/* The signal stack size: at least 64 KiB and four times the kernel's
+ * AT_MINSIGSTKSZ, rounded up to whole pages. The C library's SIGSTKSZ can be
+ * smaller than the signal frame of CPUs with large register state, and then
+ * sigaltstack() fails with ENOMEM. */
+static size_t ocsigstksz(void)
+{
+	size_t size = SIGSTKSZ;
+	size_t page = (size_t)getpagesize();
+#ifdef AT_MINSIGSTKSZ
+	size_t minimum = (size_t)getauxval(AT_MINSIGSTKSZ) * 4;
+
+	if (minimum > size)
+		size = minimum;
+#endif
+	if (size < 65536)
+		size = 65536;
+	return (size + page - 1) & ~(page - 1);
+}
